{
  "manifest_version": 3,
  "name": "D365 F&O Show Table Browser",
  "description": "Microsoft Dynamics 365 Show Table Browser",
  "version": "1.2.0",
  "author": "Semih Çelikol",
  "homepage_url": "https://github.com/semihcelikol/d365-table-browser",
  "icons": {
    "16": "img/dynamics-365-16.png",
    "48": "img/dynamics-365-48.png",
    "128": "img/dynamics-365-128.png"
  },
  "developer": {
    "name": "Semih Çelikol",
    "url": "https://semihcelikol.com/"
  },
  "permissions": [
    "storage"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "{0046fde5-f17b-435d-8f46-d3420737fa35}",
      "strict_min_version": "109.0"
    }
  },
  "action": {
    "default_icon": {
      "19": "img/dynamics-365-48.png",
      "38": "img/dynamics-365-48.png"
    },
    "default_title": "D365 F&O Show Table Browser",
    "default_popup": "index.html"
  }
}